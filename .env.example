# Postgres connection string (Neon / Supabase / local)
DATABASE_URL="postgresql://user:password@localhost:5432/trippool"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-openssl-rand-base64-32"

# Optional: email provider for magic links / invites
EMAIL_SERVER="smtp://user:pass@smtp.example.com:587"
EMAIL_FROM="TripPool <no-reply@trippool.app>"

# Socket.io
SOCKET_PORT=3001

# Explore (stays / restaurants / top places to visit) — src/lib/places.ts.
# Uses OpenStreetMap's Nominatim + Overpass APIs, which are free and need no
# API key. No env vars required here; listed for visibility only.
